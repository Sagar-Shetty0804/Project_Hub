# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost

# Registration is limited to this email domain. Leave blank to allow any email.
ALLOWED_EMAIL_DOMAIN=somaiya.edu
MAX_TEAM_SIZE=4

# Optional: send real emails for notifications (Gmail needs an App Password).
EMAIL_NOTIFICATIONS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
